# Application Configuration
APP_NAME=SLSL Number Gesture Recognition
APP_ENV=development

# Copy this file to the project root as .env and replace the example values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sl_sign_learning
DB_USER=root
DB_PASSWORD=
SECRET_KEY=

# Local development defaults
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATELIMIT_STORAGE_URI=memory://

# Personalized-learning policy; tune with representative student data.
PERSONALIZATION_MIN_ATTEMPTS=8
PERSONALIZATION_RECENT_WINDOW=10
PERSONALIZATION_PROMOTION_ACCURACY=0.85
PERSONALIZATION_PROMOTION_HISTORY_ACCURACY=0.75
PERSONALIZATION_PROMOTION_STREAK=5
PERSONALIZATION_DEMOTION_ACCURACY=0.60
PERSONALIZATION_DEMOTION_HISTORY_ACCURACY=0.70
PERSONALIZATION_DEMOTION_STREAK=3
PERSONALIZATION_WEAK_TREND_DECLINE=0.15
PERSONALIZATION_WEAK_HINT_RATE=0.5
PERSONALIZATION_WEAK_SKIP_RATE=0.25

# Optional; defaults to the repository's models/ directory
# MODEL_DIR=
